# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hookdash
DB_PASSWORD=hookdash_secret
DB_NAME=hookdash

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
