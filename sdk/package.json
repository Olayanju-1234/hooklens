{
  "name": "hookdash-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Official Node.js SDK for Hookdash — webhook capture, verification, and management",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./verify": {
      "import": "./dist/verify.js",
      "types": "./dist/verify.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware.js",
      "types": "./dist/middleware.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["hookdash", "webhook", "paystack", "flutterwave", "mono", "webhook-debugger", "sdk"],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "~8.70.1",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
